{
  "name": "@cosimi/db-core",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bu/cosimi.git",
    "directory": "packages/db-core"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "default": "./src/ports.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ports": {
        "types": "./dist/ports.d.ts",
        "default": "./dist/ports.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@cosimi/core": "workspace:^"
  },
  "devDependencies": {
    "@cosimi/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "postgres": "^3.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "postgres": "^3.4.0"
  }
}
