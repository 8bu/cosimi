{
  "name": "@simlm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#client": "./src/client.ts",
    "#repositories/*": "./src/repositories/*.ts",
    "#scripts/*": "./src/scripts/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@simlm/config": "workspace:*",
    "@simlm/normalizer": "workspace:*",
    "@simlm/types": "workspace:*",
    "postgres": "^3.4.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@simlm/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
