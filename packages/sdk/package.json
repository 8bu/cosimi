{
  "name": "@cosimi/sdk",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bu/cosimi.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./offline": {
      "types": "./src/offline/index.ts",
      "default": "./src/offline/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./offline": {
        "types": "./dist/offline/index.d.ts",
        "default": "./dist/offline/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cosimi/core": "workspace:^",
    "@cosimi/matcher": "workspace:^",
    "@cosimi/normalizer": "workspace:^"
  },
  "devDependencies": {
    "@cosimi/db-core": "workspace:*",
    "@cosimi/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "postgres": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
