{
  "name": "@cosimi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "dev:portf": "tsx watch --env-file=../../.env.portf src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "start:portf": "tsx --env-file=../../.env.portf src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:portf": "wrangler deploy -e portf",
    "deploy:cosimi": "wrangler deploy -e cosimi",
    "tail:portf": "wrangler tail -e portf",
    "tail:cosimi": "wrangler tail -e cosimi",
    "spike": "wrangler deploy -c spike/wrangler.spike.toml"
  },
  "dependencies": {
    "@cosimi/adapter-postgres": "workspace:*",
    "@cosimi/core": "workspace:*",
    "@cosimi/logger": "workspace:*",
    "@cosimi/normalizer": "workspace:*",
    "@cosimi/sdk": "workspace:*",
    "@cosimi/template": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "pino": "^10.0.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@cosimi/db-core": "workspace:*",
    "@cosimi/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
