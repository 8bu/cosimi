# Cosimi env — GraphRAG retrieval SDK + reference playgrounds.
# Everything except DATABASE_URL is optional; defaults live in @cosimi/core's
# EnvSchema (packages/core/src/env.ts), which is the source of truth.

# --- Required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cosimi

# --- Process ---
NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1
LOG_LEVEL=info

# --- GraphRAG retrieval (playgrounds/api) ---
EMBEDDING_DIM=1024
RETRIEVE_TOP_K=8
RETRIEVE_SEED_K=4
RETRIEVE_MAX_HOPS=2
RETRIEVE_MIN_SIMILARITY=0.45

# --- Runtime embedder ---
# ollama (dev/default) or workers-ai (prod; needs the AI binding inside the Worker)
EMBEDDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
WORKERS_AI_EMBED_MODEL=@cf/baai/bge-m3

# --- Offline ingest (playgrounds/admin-api) ---
# NOTE: the Anthropic API key is intentionally NOT an env var. It is operator-
# managed in the admin UI (localStorage) and sent per-request as the
# X-Anthropic-Key header, so the server holds no LLM secret at rest.
INGEST_GENERATE_MODEL=claude-sonnet-4-6
INGEST_AUDIT_MODEL=claude-haiku-4-5-20251001
STORAGE_DIR=./.storage

# --- Legacy (dormant lexical/chat surface; removed in the subtraction phase) ---
# Still validated by the schema so older .env files keep loading. Safe to omit —
# none affect the GraphRAG ingest/retrieve path.
# GC_INTERVAL_MS=300000
# SESSION_TTL_HOURS=24
# SESSION_TEACH_TTL_MINUTES=10
# EXPOSE_MATCH_INSIGHTS=false
# SSE_DELAY_MODE=token
# SSE_DELAY_BASE_MS=30
# SSE_DELAY_JITTER_MS=20
# TEACH_RATE_LIMIT_PER_HOUR=10
# TEACH_MAX_LENGTH=500
# TEACH_BLOCKLIST_REGEX=
# FALLBACK_MESSAGE=hmm idk, tell me more?
# PRUNE_SCORE_THRESHOLD=-3
